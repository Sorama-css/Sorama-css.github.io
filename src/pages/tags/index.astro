---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const tagMap = new Map<string, number>();
posts.forEach((post) => {
  post.data.tags?.forEach((tag) => {
    tagMap.set(tag, (tagMap.get(tag) || 0) + 1);
  });
});

const tags = Array.from(tagMap.entries()).sort((a, b) => b[1] - a[1]);

const formatDate = (date: Date) =>
  date.toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
---

<BaseLayout title="所有标签" description="浏览博客的所有标签分类">
  <Header />
  <main id="main-content">
    <header class="page-header animate-fade-in-up">
      <h1>所有标签</h1>
      <p>共 {tags.length} 个标签，{posts.length} 篇文章</p>
    </header>

    {tags.length > 0 && (
      <div class="tag-cloud stagger">
        {tags.map(([tag, count]) => (
          <a href={`/tags/${tag}`} class="tag">
            #{tag} <span style="opacity: 0.6;">({count})</span>
          </a>
        ))}
      </div>
    )}

    <section aria-label="最新文章">
      <h2 style="font-family: var(--font-serif); font-size: 1.3rem; margin-bottom: var(--space-lg); margin-top: var(--space-2xl);">最新文章</h2>
      <ul class="post-list stagger">
        {posts.slice(0, 5).map((post) => (
          <li class="post-item">
            <article>
              <h3 class="post-item-title" style="font-size: 1.1rem;">
                <a href={`/blog/${post.slug}`}>{post.data.title}</a>
              </h3>
              <div class="post-item-meta">
                <time datetime={post.data.pubDate.toISOString()}>
                  {formatDate(post.data.pubDate)}
                </time>
              </div>
            </article>
          </li>
        ))}
      </ul>
    </section>
  </main>
  <Footer />
</BaseLayout>
