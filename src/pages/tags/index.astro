---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// 收集所有标签及其文章数量
const tagMap = new Map<string, number>();
posts.forEach((post) => {
  post.data.tags?.forEach((tag) => {
    tagMap.set(tag, (tagMap.get(tag) || 0) + 1);
  });
});

const tags = Array.from(tagMap.entries()).sort((a, b) => b[1] - a[1]);

const formatDate = (date: Date) =>
  date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });

const getCover = (post: typeof posts[0]) =>
  post.data.cover || `https://picsum.photos/seed/${encodeURIComponent(post.slug)}/600/400`;
---

<BaseLayout title="所有标签" description="浏览博客的所有标签分类">
  <Header />
  <main id="main-content">
    <header class="page-header reveal">
      <h1 class="text-split">所有标签</h1>
      <p>共 {tags.length} 个标签，{posts.length} 篇文章</p>
    </header>

    {tags.length > 0 && (
      <div class="tag-cloud stagger" style="margin-bottom: var(--space-2xl);">
        {tags.map(([tag, count]) => (
          <a href={`/tags/${tag}`} class="tag">
            #{tag} <span style="opacity: 0.6;">({count})</span>
          </a>
        ))}
      </div>
    )}

    <section class="magazine-layout">
      <div class="section-header reveal">
        <h2 class="section-title">最新文章</h2>
      </div>
      <div class="masonry-grid">
        {posts.map((post, i) => (
          <article class="post-card tilt-card reveal" data-delay={(i % 6) * 80}>
            <a href={`/blog/${post.slug}`} style="text-decoration: none; color: inherit;">
              <div class="card-cover-wrap">
                <img class="card-cover" src={getCover(post)} alt={post.data.title} loading="lazy" />
              </div>
              <div class="card-body">
                {post.data.category && <span class="card-category">{post.data.category}</span>}
                <h3 class="card-title">{post.data.title}</h3>
                <p class="card-excerpt">{post.data.description}</p>
                <div class="card-footer">
                  <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                </div>
              </div>
            </a>
          </article>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
