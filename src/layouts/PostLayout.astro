---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  post: {
    title: string;
    description: string;
    pubDate: Date;
    updatedDate?: Date;
    tags?: string[];
  };
  prevPost?: { slug: string; title: string } | null;
  nextPost?: { slug: string; title: string } | null;
}

const { post, prevPost, nextPost } = Astro.props;

const formatDate = (date: Date) =>
  date.toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
---

<BaseLayout title={post.title} description={post.description}>
  <Header />
  <main id="main-content">
    <a href="/" class="back-link animate-fade-in">← 返回文章列表</a>

    <article>
      <header class="post-header animate-fade-in-up">
        <h1 class="post-title">{post.title}</h1>
        <div class="post-meta">
          <time datetime={post.pubDate.toISOString()}>{formatDate(post.pubDate)}</time>
          {post.updatedDate && (
            <span>· 更新于 {formatDate(post.updatedDate)}</span>
          )}
          {post.tags && post.tags.length > 0 && (
            <span>· {post.tags.length} 个标签</span>
          )}
        </div>
        {post.tags && post.tags.length > 0 && (
          <div class="tags" style="margin-top: 1rem;">
            {post.tags.map((tag) => (
              <a href={`/tags/${tag}`} class="tag">#{tag}</a>
            ))}
          </div>
        )}
      </header>

      <div class="post-content animate-fade-in-up">
        <slot />
      </div>
    </article>

    <nav class="post-nav" aria-label="文章导航">
      {prevPost ? (
        <a href={`/blog/${prevPost.slug}`} class="post-nav-item">
          <span class="post-nav-label">← 上一篇</span>
          <span class="post-nav-title">{prevPost.title}</span>
        </a>
      ) : <div class="post-nav-item" />}
      {nextPost ? (
        <a href={`/blog/${nextPost.slug}`} class="post-nav-item" style="text-align: right;">
          <span class="post-nav-label">下一篇 →</span>
          <span class="post-nav-title">{nextPost.title}</span>
        </a>
      ) : <div class="post-nav-item" />}
    </nav>
  </main>
  <Footer />
</BaseLayout>
